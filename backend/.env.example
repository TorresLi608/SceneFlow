# 后端监听端口。
# Backend listening port.
PORT=8080

# SQLite 默认使用项目根目录 data/app.db；Docker 默认 /app/data/app.db。
# SQLite defaults to data/app.db at the repository root; Docker uses /app/data/app.db.
# 本地开发和部署统一使用 DATABASE_URL；不设置时使用默认路径，绝对路径需要四个斜杠。
# Local development and deployment use DATABASE_URL; leave unset for the default, or use four slashes for an absolute path.
# DATABASE_URL=sqlite:////absolute/path/app.db

# Docker Compose 宿主机持久化数据挂载目录；未设置时默认为 ./data。
# Host data directory mounted by Docker Compose; defaults to ./data.
SCENEFLOW_DATA_DIR=./data


# 运行环境；生产环境请设为 production。
# Runtime environment; set to production in production.
SCENEFLOW_ENV=development

# JWT 签名密钥；生产环境必须替换。
# JWT signing secret; must be replaced in production.
SCENEFLOW_JWT_SECRET=dev-jwt-secret-change-me-at-least-32-bytes

# API 密钥加密主密钥；生产环境必须替换。
# Master secret used to encrypt provider API keys; must be replaced in production.
SCENEFLOW_AES_KEY=dev-aes-key-change-me

# 超级管理员登录名（3–64 字符）；旧默认管理员会原地改名，保留 ID 和密码。
# Super-admin login (3–64 characters); renames the legacy default admin, preserving ID/password.
SCENEFLOW_SUPER_ADMIN_USERNAME=superAdmin

# 初始超级管理员密码；生产环境必须替换，不会覆盖已有账号密码。
# Initial super-admin password; replace in production; does not reset an existing password.
SCENEFLOW_SUPER_ADMIN_PASSWORD=superAdmin@123

# 对外可访问的后端基础地址，用于生成媒体签名链接。
# Public backend base URL used to generate signed media links.
SCENEFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8080

# 允许跨域访问的前端地址，多个地址用英文逗号分隔。
# Allowed frontend origins, separated by commas.
SCENEFLOW_CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# 私有生成文件目录，相对路径以 backend/ 为基准。
# Private generated-file directory; relative paths are resolved from backend/.
SCENEFLOW_PRIVATE_GENERATED_DIR=../data/private_generated

# 可选的中文 TTF/TTC 字体路径；留空时自动探测。
# Optional CJK TTF/TTC font path; leave empty for automatic detection.
SCENEFLOW_CJK_FONT_PATH=

# 生成 Word 文档时使用的中文字体名称。
# CJK font name used in generated Word documents.
SCENEFLOW_CJK_FONT_NAME=Arial Unicode MS

# 聊天上下文最大 token 数，最低为 10000。
# Maximum chat context token count, with a minimum of 10000.
SCENEFLOW_MAX_CONTEXT_TOKENS=100000

# 后端日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
# Backend log level, such as DEBUG, INFO, WARNING, or ERROR.
SCENEFLOW_LOG_LEVEL=INFO

# 可选：自建 SearXNG 元搜索引擎基础地址，配置后在智能问答中启用网络搜索 (web_search) 功能。
# 留空或不设置则禁用联网搜索。实例的 settings.yml 需在 search.formats 中加入 json（默认只有 html，否则请求返回 HTTP 403），
# 且 limiter 需放行 API 客户端。每轮对话最多进行 3 次不同关键词的搜索。
# Optional: Self-hosted SearXNG base URL. Enables web_search in chat assistant when configured.
# Leave empty or unset to disable web search. The instance must enable `json` under search.formats
# (HTML-only defaults answer JSON requests with HTTP 403) and its limiter must allow API clients.
SCENEFLOW_SEARXNG_BASE_URL=

# 可选：SearXNG 引擎令牌 (Engine Token)，若私有引擎设置了访问令牌需在此配置。
# Optional: SearXNG engine token for restricted/private engines.
SCENEFLOW_SEARXNG_ENGINE_TOKEN=

# 可选：指定使用的搜索引擎名称（多个用逗号分隔，微信公众号搜索请使用 sogou wechat，也支持简写 wechat）。
# 留空时系统默认自动使用高可用引擎组合，确保无需额外配置即可秒级精准检索。
# Optional: Comma-separated search engines (for WeChat articles use 'sogou wechat' or 'wechat').
# Defaults to stable engines if unset.
SCENEFLOW_SEARXNG_ENGINES=vuhuv,naver,abcnyheter,encyclosearch,sogou wechat,yandex,bing,sogou

# 可选：返回给大模型的精选网页条数（默认 4 条，建议 3~5 条，过多会导致模型生成回复缓慢甚至超时）。
# Optional: Number of search results fed into the LLM (defaults to 4).
SCENEFLOW_SEARXNG_RESULT_COUNT=4

# 可选：单条搜索摘要最大字符数（默认 180 字符），防止单个冗长网页挤占上下文。
# Optional: Maximum characters per snippet (defaults to 180).
SCENEFLOW_SEARXNG_MAX_SNIPPET_CHARS=180

# 可选：所有搜索结果注入大模型的总字符预算（默认 900 字符），保障模型秒级首字输出。
# Optional: Total character budget for search results (defaults to 900).
SCENEFLOW_SEARXNG_MAX_TOTAL_CHARS=900

# 可选：Crawl4AI 网页深度抓取与清洗服务地址（例如 http://localhost:11235）。
# 推荐 Docker 运行：docker run -d -p 11235:11235 unclecode/crawl4ai
# 若未配置，系统会自动检测本地 crawl4ai 库或使用内置轻量提取器平滑降级。
# 无论哪种方式，抓取前都会校验链接为公网 HTTP(S) 地址；内置提取器逐跳校验重定向、只读取前 2 MB 文本内容，单次抓取总时长 30 秒。
# Optional: Crawl4AI service base URL for deep web page extraction and Markdown cleaning.
# Every fetch first requires a public HTTP(S) URL; the built-in extractor re-checks each redirect hop,
# reads at most 2 MB of textual content, and one fetch is bounded to 30 seconds overall.
SCENEFLOW_CRAWL4AI_BASE_URL=

# 可选：Crawl4AI 访问令牌（若服务启用了 CRAWL4AI_API_TOKEN 鉴权）。
# Optional: Crawl4AI API token if the service requires authentication.
SCENEFLOW_CRAWL4AI_API_TOKEN=

# 可选：网页深度提取送入大模型的最大正文字符预算（默认 2000 字符），防止大长文卡顿。
# Optional: Maximum characters for extracted web content fed to LLM (defaults to 2000).
SCENEFLOW_CRAWL4AI_MAX_CHARS=2000

