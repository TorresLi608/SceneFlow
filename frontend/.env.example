# Next.js 服务端访问后端 API 的地址，用于 BFF 重写。
# Backend API URL used by the Next.js server for BFF rewrites.
BACKEND_API_BASE_URL=http://127.0.0.1:8080

# 浏览器请求 BFF 的基础地址；留空表示使用当前站点同源地址。
# Browser BFF base URL; leave empty to use the current origin.
NEXT_PUBLIC_BFF_BASE_URL=

# 浏览器连接后端 WebSocket 的地址。
# Backend WebSocket URL used by the browser.
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8080

# 旧版后端地址回退项；新配置请优先使用 BACKEND_API_BASE_URL。
# Legacy backend URL fallback; prefer BACKEND_API_BASE_URL for new setups.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
